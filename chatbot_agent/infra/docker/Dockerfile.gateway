# Build from the repo root: docker build -f infra/docker/Dockerfile.gateway .
FROM python:3.10-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=300 PIP_RETRIES=10 PYTHONPATH=/app
WORKDIR /app

COPY apps/query_gateway/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY shared ./shared
COPY apps/query_gateway/src ./src
RUN useradd --create-home appuser && chown -R appuser /app
USER appuser

EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8010/health')" || exit 1

CMD ["uvicorn", "app.api:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8010"]
