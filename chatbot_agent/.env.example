# Copy to .env (git-ignored) and fill in. Read by both services.
QDRANT_CLUSTER_ENDPOINT=https://your-qdrant-cluster-endpoint
QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_COLLECTION=rag_documents
QDRANT_VECTOR_SIZE=512
EMBEDDING_MODEL=gemini-embedding-001
API_AUTH_KEY=replace-with-a-strong-api-key
ALLOWED_ORIGINS=*
MIN_RETRIEVAL_SCORE=0.25
DB_ENABLED=false
DB_URL=
SQL_PLANNER_API_ENABLED=false
SQL_PLANNER_API_KEY=replace-with-a-strong-sql-api-key
SQL_QUERY_EXECUTION_ENABLED=false
DB_QUERY_TIMEOUT_MS=5000
POSTGRES_DB=closeloop
POSTGRES_USER=closeloop
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Redis cache + shared Gemini rate limiter (docker compose builds REDIS_URL from the password)
REDIS_PASSWORD=change-me-long-random
CACHE_ENABLED=true
LOG_LEVEL=INFO
# Redis UI login (user admin). bcrypt hash of REDIS_PASSWORD, generated with:
#   docker compose exec redis_ui node bin/bcrypt-password.js -p "<REDIS_PASSWORD>"   (wrap the value in single quotes)
REDIS_UI_PASSWORD_HASH='$2b$10$replace-with-generated-hash'

# ---- LLM provider ------------------------------------------------------------------------------
# Primary provider: gemini | openai | anthropic (alias: claude) | openai_compatible (alias: ollama, openrouter, groq)
LLM_PROVIDER=gemini
# Backups, tried in order when the primary is rate-limited, out of quota, rejecting the key, or down.
# Example: LLM_FALLBACKS=anthropic,openai
LLM_FALLBACKS=
# Each provider activates only when its key and model are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible server (Ollama, vLLM, LM Studio, OpenRouter, Groq...); key optional for local ones
LLM_COMPAT_BASE_URL=
LLM_COMPAT_API_KEY=
LLM_COMPAT_MODEL=
# Requests/minute your plan allows per provider (0 = no client-side limit)
GEMINI_MAX_RPM=0
OPENAI_MAX_RPM=0
ANTHROPIC_MAX_RPM=0
LLM_COMPAT_MAX_RPM=0

# ---- Conversation memory (needs Redis) -----------------------------------------------------------
# Lets follow-ups like "and last month?" work. The client sends a random session_id with each request.
CHAT_MEMORY_ENABLED=true
# Question/answer pairs remembered per conversation
CHAT_MEMORY_TURNS=8
# Seconds of silence before a conversation is forgotten
CHAT_MEMORY_TTL_S=1800
CHAT_MEMORY_MAX_QUESTION_CHARS=600
CHAT_MEMORY_MAX_ANSWER_CHARS=1500
# RabbitMQ broker for document processing
RABBITMQ_USER=closeloop
RABBITMQ_PASSWORD=change-me
INGEST_CONCURRENCY=4
INGEST_RATE_LIMIT=120/m
