# CloseLoop — production environment (TEMPLATE)
#
# Copy to .env.prod on the server and fill in real values:
#   cp .env.prod.example .env.prod
#   openssl rand -hex 32      # -> JWT_SECRET
#   openssl rand -base64 24   # -> POSTGRES_PASSWORD
#
# .env.prod is git-ignored. Never commit real secrets.
#
# Used by:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ---- Public identity --------------------------------------------------------
# Exact origin the browser uses. Drives backend CORS + secure-cookie scoping.
# Scheme + host, NO trailing slash.
PUBLIC_URL=https://closeloop.foursymmetrons.com

# Bare hostname, used for the TLS certificate + nginx server_name.
DOMAIN=closeloop.foursymmetrons.com

# Leave blank unless the session must be shared across sub-domains.
COOKIE_DOMAIN=

# Address Let's Encrypt uses for expiry notices.
CERTBOT_EMAIL=admin@foursymmetrons.com

# ---- Database -------------------------------------------------------------
POSTGRES_USER=closeloop
POSTGRES_DB=closeloop
POSTGRES_PASSWORD=CHANGE_ME

# ---- Auth ---------------------------------------------------------------
# The backend REFUSES to start in production with a placeholder here.
JWT_SECRET=CHANGE_ME

# ---- "Forgot password" email delivery (Gmail SMTP or any SMTP provider) ---
# Leave SMTP_HOST/SMTP_USERNAME blank to disable email sending — the
# forgot-password endpoint still responds normally either way, it just
# logs the reset link instead of emailing it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME@gmail.com
# A Gmail App Password (myaccount.google.com/apppasswords), not the
# account's real login password — paste it with no spaces.
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME@gmail.com
SMTP_USE_TLS=true

# ---- HRMS integration (HRMS Integration page -> project list) -------------
# Leave HRMS_TENANT_ID / HRMS_SECRET blank to disable. Wrap the secret in
# SINGLE quotes — it may contain "$", which compose would otherwise expand.
HRMS_BASE_URL=https://api-hrms.innovationnxt.com/backend
HRMS_TENANT_ID=
HRMS_SECRET=

# ---- Automated timesheet ---------------------------------------------------
# Leave both false until the HRMS timesheet API is connected (backend/TIMESHEET.md):
# submitting can't work without it, and reminders would nag about a timesheet
# nobody can complete.
# Routes relative to HRMS_BASE_URL, same tenant-key header as the activities call.
# POST = the HRMS's timesheet route (one request per day). Blank = not connected
# (nothing is sent). LIST blank = the HRMS can't be read back (CloseLoop then only
# prevents re-sending its own entries) - true of the HRMS in use.
HRMS_TIMESHEET_POST_PATH=/v1/external/timesheets
HRMS_TIMESHEET_LIST_PATH=
TIMESHEET_SUBMIT_ENABLED=false
TIMESHEET_REMINDERS_ENABLED=false

# ---- Chatbot (Close Bhai) -------------------------------------------------
# Needs the chatbot stack (chatbot_agent/docker-compose.prod.yml) running on this network.
# The keys must equal the gateway's SQL_PLANNER_API_KEY / API_AUTH_KEY (openssl rand -hex 32).
# Leave CHATBOT_ENABLED=false to hide the assistant.
CHATBOT_ENABLED=false
CHATBOT_URL=http://chatbot-gateway:8010
CHATBOT_SQL_API_KEY=
CHATBOT_API_KEY=
# Capacity knobs — self-imposed ceilings on THIS backend only (it's single-process by
# design, see the backend service's own comment in docker-compose.prod.yml, so these
# are process-global, not per-replica). Raising them does not raise the real capacity
# of the query gateway, its LLM provider's own rate limit, or the shared Postgres the
# gateway reads from — load-test against those before trusting a higher number here.
# Defaults below are sized for a multi-hundred-seat tenant base; tune down for a small
# pilot, up only after confirming the gateway/LLM/DB can actually take it.
CHATBOT_RATE_LIMIT_PER_MINUTE=20
CHATBOT_MAX_CONCURRENT=40
CHATBOT_MAX_CONCURRENT_PER_USER=3
