# development | production — production mode enforces a real JWT_SECRET and
# COOKIE_SECURE=true at startup (see Settings.assert_production_ready).
ENV=development

# Postgres connection (asyncpg driver). For Docker compose the host is `db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/closeloop

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=7

# Session cookies. Set COOKIE_SECURE=true once the app is served over HTTPS
# (required in production). Leave COOKIE_DOMAIN unset unless you need to
# share the session across subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PORT=8000

# Origin used to build links sent in emails (the "forgot password" link).
PUBLIC_APP_URL=http://localhost:5173

# "Forgot password" email delivery. Leave SMTP_HOST/SMTP_USERNAME blank to
# disable sending — the endpoint still responds normally, it just logs the
# reset link instead (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
