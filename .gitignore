# Secrets: only the *.example templates are committed
.env
.env.*
!.env.example
!.env.prod.example

# Production data must never be committed
*backup*.sql
*_manifest_*.csv
*.dump

# Notebooks may embed keys in their outputs
*.ipynb

# Dependencies, build output, caches
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.log

# Local tooling
.claude/
.DS_Store
